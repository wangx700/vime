@@ -0,0 +1,54 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+import json
+from unittest.mock import MagicMock
+
+import pytest
+
+from vllm.distributed.weight_transfer import profiling
+
+
+def test_disabled_profile_does_not_synchronize(monkeypatch):
+    monkeypatch.delenv("VLLM_WEIGHT_TRANSFER_PROFILE", raising=False)
+    monkeypatch.setattr(
+        profiling.torch.accelerator,
+        "synchronize",
+        lambda: pytest.fail("disabled profile synchronized"),
+    )
+    profiler = profiling.WeightTransferProfiler(device="npu")
+    with profiler.measure("receive"):
+        pass
+    with profiler.measure_host("staging"):
+        pass
+    logger = MagicMock()
+    profiler.log(logger, role="test")
+    assert not profiler.seconds and not profiler.calls
+    logger.info.assert_not_called()
+
+
+def test_profile_records_exception_and_reports_units(monkeypatch):
+    monkeypatch.setenv("VLLM_WEIGHT_TRANSFER_PROFILE", "1")
+    ticks = iter([2.0, 5.0])
+    monkeypatch.setattr(profiling, "perf_counter", lambda: next(ticks))
+    profiler = profiling.WeightTransferProfiler(device="cpu")
+    with pytest.raises(RuntimeError), profiler.measure("receive"):
+        raise RuntimeError("load failed")
+    logger = MagicMock()
+    profiler.log(logger, role="test")
+    record = json.loads(logger.info.call_args.args[1])
+    assert record["seconds"] == {"receive": 3.0}
+    assert record["calls"] == {"receive": 1}
+
+
+def test_nested_host_observers_only_synchronize_outer_phase(monkeypatch):
+    monkeypatch.setenv("VLLM_WEIGHT_TRANSFER_PROFILE", "1")
+    ticks = iter([2.0, 3.0, 5.0, 7.0])
+    monkeypatch.setattr(profiling, "perf_counter", lambda: next(ticks))
+    profiler = profiling.WeightTransferProfiler(device="npu")
+    synchronize = MagicMock()
+    monkeypatch.setattr(profiler, "_synchronize", synchronize)
+    with profiler.measure("apply"), profiler.measure_host("staging"):
+        pass
+    assert synchronize.call_count == 2
+    assert dict(profiler.seconds) == {"staging_host_dispatch": 2.0, "apply": 5.0}
+    assert dict(profiler.calls) == {"staging_host_dispatch": 1, "apply": 1}
