+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Opt-in, synchronized weight-transfer phase diagnostics.
+
+Profiling inserts device synchronization and is intended for attribution runs,
+not throughput claims. Disabled instrumentation never synchronizes the device.
+Nested/inclusive phases must not be summed together.
+Per-tensor host observers deliberately avoid device synchronization; their
+``_host_dispatch`` suffix distinguishes them from completed device phases.
+"""
+
+import json
+import os
+from collections import defaultdict
+from contextlib import contextmanager
+from time import perf_counter
+
+import torch
+
+
+class WeightTransferProfiler:
+    def __init__(self, *, device=None):
+        self.enabled = os.environ.get("VLLM_WEIGHT_TRANSFER_PROFILE", "0") == "1"
+        self.device = device
+        self.seconds = defaultdict(float)
+        self.calls = defaultdict(int)
+
+    def _synchronize(self):
+        if self.device is not None and torch.device(self.device).type != "cpu":
+            torch.accelerator.synchronize()
+
+    @contextmanager
+    def measure(self, phase):
+        if not self.enabled:
+            yield
+            return
+        self._synchronize()
+        start = perf_counter()
+        try:
+            yield
+        finally:
+            self._synchronize()
+            self.seconds[phase] += perf_counter() - start
+            self.calls[phase] += 1
+
+    @contextmanager
+    def measure_host(self, phase):
+        """Record host residence, including implicit waits, without extra sync.
+
+        Use inside an outer synchronized phase for per-tensor staging/loading.
+        This is not isolated device execution time and must not be added to
+        the containing completed-device phase.
+        """
+        if not self.enabled:
+            yield
+            return
+        start = perf_counter()
+        try:
+            yield
+        finally:
+            phase = f"{phase}_host_dispatch"
+            self.seconds[phase] += perf_counter() - start
+            self.calls[phase] += 1
+
+    def log(self, logger, **identity):
+        if self.enabled:
+            logger.info(
+                "WEIGHT_TRANSFER_PROFILE %s",
+                json.dumps(
+                    dict(identity, seconds=dict(self.seconds), calls=dict(self.calls)),
+                    sort_keys=True,
+                ),
+            )
